# Template for Android Release Keystore signing
# Copy this file to `key.properties` and fill in your keystore credentials:
# cp key.properties.example key.properties
#
# Generate a new upload keystore using keytool:
# keytool -genkey -v -keystore app/upload-keystore.jks -keyalg RSA -keysize 2048 -validity 10000 -alias upload
#
storePassword=your_store_password_here
keyPassword=your_key_password_here
keyAlias=upload
storeFile=../upload-keystore.jks
